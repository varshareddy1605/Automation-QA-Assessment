      "parameters": {
        "jsCode": "// Turn whatever the failed node returned into one readable alert line\nconst e = $json.error;\nlet msg = 'unknown error';\nif (typeof e === 'string') msg = e;\nelse if (e && e.message) msg = e.message;\nelse if (e) msg = JSON.stringify(e).slice(0, 300);\nreturn [{ json: { content: '⚠️ **Morning Brief failed**\\nReason: ' + msg + '\\nTime: ' + new Date().toISOString() + '\\nCheck the n8n execution log for details.' } }];"
      },
