      "id": "c9f3cc36-1246-49fd-8b10-9be9216fe216",
      "name": "GitHub Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        272,
        224
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Keep only the top 5 non-archived repos by stars\nconst res = $input.first().json;\nconst repos = (res.items || []).filter(r => !r.archived);\nconst sorted = repos.sort((a, b) => b.stargazers_count - a.stargazers_count).slice(0, 5);\nif (!sorted.length) {\n  throw new Error('GitHub returned no repositories for this topic');\n}\nconst shorten = (s, n) => s.length <= n ? s : s.slice(0, n).replace(/\\s+\\S*$/, '') + '...';\nconst top5 = sorted.map(r => ({\n  full_name: r.full_name,\n  stars: r.stargazers_count,\n  url: r.html_url,\n  language: r.language || 'n/a',\n  description: shorten(r.description || 'No description', 100)\n}));\nreturn [{ json: { topic: 'automation', top5, topRepo: top5[0] } }];"
      },
      "id": "5ededcad-a7b6-417f-94fc-00c75d85c7c7",
      "name": "Top 5",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        128
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.topRepo.full_name }}/readme",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw+json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-morning-brief"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "a4d3da6a-8abc-4012-aa03-6624dc04b0c1",
      "name": "Fetch README",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        784,
        112
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Combine top 5 list + README excerpt of the #1 repo into one digest payload\nconst top = $('Top 5').first().json;\nconst r = $input.first().json;   // README response (or an error item if the call failed)\n\nlet excerpt = '(README unavailable)';\nif (r && typeof r.data === 'string' && r.data.length) {\n  const cleaned = r.data\n    .replace(/!?\\[[^\\]]*\\]\\([^)]*\\)/g, '')   // markdown links/images\n    .replace(/<[^>]+>/g, '')                 // html tags\n    .replace(/[#>*`|_-]{1,}/g, ' ')          // markdown symbols\n    .replace(/\\s+/g, ' ')\n    .trim();\n  if (cleaned.length) excerpt = cleaned.slice(0, 280) + '...';\n}\n\nconst list = top.top5\n  .map((x, i) => `${i + 1}. [${x.full_name}](<${x.url}>) - ${x.stars.toLocaleString('en-US')} stars - ${x.description}`)\n  .join('\\n');\n\nreturn [{ json: {\n  topic: top.topic,\n  topStars: top.topRepo.stars,\n  spotlightName: top.topRepo.full_name,\n  list,\n  excerpt\n} }];"
      },
      "id": "ad38bab3-91ee-464f-84ec-ba8bec6b9467",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
